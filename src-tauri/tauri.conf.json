{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Library",
  "mainBinaryName": "skills-library",
  "version": "0.1.0",
  "identifier": "com.cheapbutsimilar.skillslibrary",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Claude · Claude Code · Codex 스킬 라이브러리",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNEM0MEVBOUZBMkE5NUEKUldSYXFhS2Y2a0JNUU9jREMxWmtubzNtVlI1eVYrakxrS1NqUjZjb3g3emI5RGZsUkczTVVvcDAK",
      "endpoints": [
        "https://github.com/cheapbutsimilar/skills-Library/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
